# The app on developers: its ID, and the operate private key you registered for it (Ed25519 JWK, one line)
CLAVIS_APP_ID=
OPERATE_PRIVATE_JWK=
# The master public JWK from https://api.clavis.nexus/.well-known/jwks.json (the "master" member, one line)
MASTER_PUBLIC_JWK_JSON=
# The person who runs this server, as the app knows them in Clavis: the OIDC sub, or the sub of an earlier signature
CLAVIS_SIGNER=
